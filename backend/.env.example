# Required. Keep this file local; never add real values to source control.
INVITATION_CODE=replace-with-a-long-random-code
SESSION_SECRET=replace-with-at-least-32-random-bytes
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-3.8-flash
CHAT_PROVIDER=mock
ANTIGRAVITY_AGENT=antigravity-preview-09-2026
# Optional; omit to use the agent default.
ANTIGRAVITY_MODEL=
# Dialog only; typed chat and Live keep their existing providers.
DIALOG_MODEL=gemini-2.5-flash-native-audio-preview-12-2025
# Owner confirmed billing disabled on 2026-10-10. Set false if that changes.
# This flag records confirmation; it does not disable billing at Google.
DIALOG_FREE_TIER_CONFIRMED=true
PORT=8080
ALLOWED_ORIGINS=http://localhost:5173
MAX_DAILY_REQUESTS=250
